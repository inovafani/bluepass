generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OperatorStatus {
  GHOST
  CLAIMED
  ACTIVE
  SUSPENDED
}

enum PmsPlatform {
  REZDY
  FAREHARBOR
  BOKUN
  NATIVE
}

enum CertLevel {
  NONE
  OW
  AOW
  RESCUE
  DIVEMASTER
  INSTRUCTOR
}

enum BookingStatus {
  QUOTE_DRAFTED
  OPERATOR_NOTIFIED
  OPERATOR_ACCEPTED
  OPERATOR_DECLINED
  COUNTER_REQUESTED
  AUTO_DECLINED
  PMS_HOLD_PLACED
  AWAITING_PAYMENT
  CONFIRMED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum ActorType {
  TRAVELLER
  OPERATOR
  SYSTEM
  KAI
}

enum TransferStatus {
  QUEUED
  SENT
  CONFIRMED
  FAILED
}

enum SignupRole {
  OPERATOR
  CREATOR
}

enum KaiChannel {
  WEB      @map("web")
  WHATSAPP @map("whatsapp")
}

enum KaiSessionStatus {
  OPEN    @map("open")
  HANDOFF @map("handoff")
  CLOSED  @map("closed")
}

enum KaiMessageRole {
  USER      @map("user")
  ASSISTANT @map("assistant")
  SYSTEM    @map("system")
}

enum BookingInquiryStatus {
  DRAFT
  READY_TO_DISPATCH
  OPERATOR_PENDING
  OPERATOR_ACCEPTED
  OPERATOR_DECLINED
  COUNTER_OFFERED
  EXPIRED
}

enum WhatsAppOutboundStatus {
  QUEUED
  SENT
  FAILED
}

model Operator {
  id           String                @id @default(cuid())
  name         String
  status       OperatorStatus        @default(GHOST)
  whatsappE164 String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  trips        Trip[]
  bookings     Booking[]
  integrations OperatorIntegration[]
  bookingInquiries BookingInquiry[]
  whatsappOutboundMessages WhatsAppOutboundMessage[]
}

model Trip {
  id          String     @id @default(cuid())
  operatorId  String
  externalId  String?
  title       String
  description String?
  location    String?
  imageUrl    String?
  currency    String     @default("USD")
  priceCents  Int
  minCert     CertLevel  @default(NONE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  operator    Operator   @relation(fields: [operatorId], references: [id])
  bookings    Booking[]

  @@index([operatorId])
  @@unique([operatorId, externalId])
}

model Traveller {
  id           String       @id @default(cuid())
  whatsappE164 String       @unique
  displayName  String?
  certLevel    CertLevel    @default(NONE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  bookings     Booking[]
  kaiSessions  KaiSession[]
}

model Booking {
  id                     String                 @id @default(cuid())
  operatorId             String
  tripId                 String
  travellerId            String
  status                 BookingStatus          @default(QUOTE_DRAFTED)
  totalCents             Int
  currency               String                 @default("USD")
  creatorAttributionCode String?
  pmsPlatform            PmsPlatform            @default(NATIVE)
  pmsHoldId              String?
  pmsHoldExpiresAt       DateTime?
  paymentLinkUrl         String?
  confirmedAt            DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  operator               Operator               @relation(fields: [operatorId], references: [id])
  trip                   Trip                   @relation(fields: [tripId], references: [id])
  traveller              Traveller              @relation(fields: [travellerId], references: [id])
  events                 BookingEvent[]
  conservationTransfer   ConservationTransfer?

  @@index([operatorId, status])
  @@index([travellerId])
  @@index([tripId])
}

model BookingEvent {
  id         String        @id @default(cuid())
  bookingId  String
  fromStatus BookingStatus?
  toStatus   BookingStatus
  actorType  ActorType
  payload    Json?
  createdAt  DateTime      @default(now())
  booking    Booking       @relation(fields: [bookingId], references: [id])

  @@index([bookingId, createdAt])
}

model KaiSession {
  id             String           @id @default(cuid())
  channel        KaiChannel
  externalUserId String?
  travellerId    String?
  travellerPhone String?
  status         KaiSessionStatus @default(OPEN)
  slots          Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  traveller      Traveller?       @relation(fields: [travellerId], references: [id])
  messages       KaiMessage[]

  @@index([channel, status])
  @@index([externalUserId])
  @@index([travellerId])
  @@index([travellerPhone])
}

model KaiMessage {
  id        String         @id @default(cuid())
  sessionId String
  channel   KaiChannel
  role      KaiMessageRole
  content   String
  metadata  Json?
  createdAt DateTime       @default(now())
  session   KaiSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([channel, createdAt])
}

model BookingInquiry {
  id                  String                 @id @default(cuid())
  sourceChannel       KaiChannel
  kaiSessionId        String?
  selectedYachtSlug   String?
  selectedYachtName   String?
  travellerName       String?
  travellerEmail      String?
  travellerPhone      String?
  destination         String?
  tripType            String?
  dateWindow          String?
  guests              Int?
  certificationLevel  String?
  budget              String?
  interests           Json?
  notes               String?
  status              BookingInquiryStatus  @default(DRAFT)
  operatorId          String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  operator            Operator?              @relation(fields: [operatorId], references: [id])
  outboundMessages    WhatsAppOutboundMessage[]

  @@index([kaiSessionId, status])
  @@index([selectedYachtSlug])
  @@index([operatorId, status])
  @@index([createdAt])
}

model WhatsAppOutboundMessage {
  id                String                 @id @default(cuid())
  bookingInquiryId  String
  operatorId        String?
  channel           KaiChannel             @default(WHATSAPP)
  recipientPhone    String
  templateName      String
  providerMessageId String?
  status            WhatsAppOutboundStatus @default(QUEUED)
  sentAt            DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  metadata          Json?
  bookingInquiry    BookingInquiry         @relation(fields: [bookingInquiryId], references: [id], onDelete: Cascade)
  operator          Operator?              @relation(fields: [operatorId], references: [id])

  @@index([bookingInquiryId])
  @@index([recipientPhone, status, sentAt])
  @@index([operatorId, status])
}

model ConservationTransfer {
  id          String         @id @default(cuid())
  bookingId   String         @unique
  amountCents Int
  currency    String         @default("USD")
  status      TransferStatus @default(QUEUED)
  payload     Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  booking     Booking        @relation(fields: [bookingId], references: [id])
}

model OperatorIntegration {
  id                   String      @id @default(cuid())
  operatorId           String
  platform             PmsPlatform
  encryptedCredentials String
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  operator             Operator    @relation(fields: [operatorId], references: [id])

  @@unique([operatorId, platform])
}

model SignupLead {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String
  roles     SignupRole[] @default([])
  createdAt DateTime   @default(now())

  @@index([createdAt])
  @@index([email])
}
